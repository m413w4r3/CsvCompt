# Configuration locale prévue — copier vers .env (ignoré par Git). Aucune valeur secrète ici.
# (Nommé env.example : les règles de permission de l'environnement de développement
#  interdisent la création d'un fichier .env.example par les agents.)
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./data/db/comptes.sqlite
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# Opt-in local : chemin vers un vrai CSV pour les tests opt_in_real_data ; vide = tests ignorés.
COMPTES_REAL_CSV=
